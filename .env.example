# Required: 16+ char secret used to encrypt stored OAuth tokens / API keys.
# Generate with: openssl rand -hex 32
# Do NOT leave the placeholder — Docker will refuse to start with it.
APP_SECRET=

# App
PORT=3847
TZ=Asia/Shanghai

# Optional: override data directory (default ./data at repo root)
# DATA_DIR=./data

# Optional panel access auth (Basic Auth). Unset = open (ok for localhost/LAN only).
# For any public exposure, set one of:
#   PANEL_PASSWORD=your-shared-password          # user defaults to "admin"
#   BASIC_AUTH_USER=admin                        # optional override
#   BASIC_AUTH_PASSWORD=your-shared-password     # takes precedence over PANEL_PASSWORD
# PANEL_PASSWORD=
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=

# Optional: allow POST /api/demo/seed with fictional example.com data
# ALLOW_DEMO_SEED=1
